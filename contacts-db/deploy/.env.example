# Values for the Hostinger project's `environment` (or a local .env). NEVER commit real values.

# --- Supabase (run deploy/supabase_setup.sql once; it makes a dedicated role + schema) ---
# Connect as the dedicated role through the SESSION pooler (IPv4-safe, port 5432):
NTXP_DB_URL=postgresql://ntxp_contacts_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
NTXP_PG_SCHEMA=ntxp_contacts

# --- Google sign-in: OAuth client ID (type "Web application"), consent screen User type = INTERNAL ---
#   Authorized JavaScript origins: https://contacts.ntxpllc.cloud
NTXP_GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com

# --- The existing proxy on the VPS (read from the hostinger-mcp compose, RUNBOOK step 1) ---
PROXY_NETWORK=proxy
TRAEFIK_CERTRESOLVER=mytlschallenge

# --- Interlinks (generate each secret with `ntxp peers keygen <name>`; give the SAME secret to that app) ---
# URLs are YOUR hostnames; they must end in .ntxpllc.cloud (enforced). Contracts is pulled, the others get webhooks.
NTXP_PEERS={"schedules":{"url":"https://<schedules-host>.ntxpllc.cloud","secret":"<secret>"},"contracts":{"url":"https://<contracts-host>.ntxpllc.cloud","secret":"<secret>"},"formfill":{"url":"https://<formfill-host>.ntxpllc.cloud","secret":"<secret>"}}

# --- Optional: model-council judges (JEV works with none) ---
#DEEPSEEK_API_KEY=
#XAI_API_KEY=
#OPENAI_API_KEY=
